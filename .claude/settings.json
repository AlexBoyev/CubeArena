{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(*)",
      "PowerShell(*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",

      "Bash(git reset --hard *)",
      "PowerShell(git reset --hard *)"
    ],
    "additionalDirectories": [
      "F:\\Unity"
    ],
    "blockReadsOutsideWorkingDirectories": true
  }
}
