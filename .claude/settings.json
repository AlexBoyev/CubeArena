      "PowerShell(dotnet *)",

      "Bash(git *)",
      "PowerShell(git *)",

      "Bash(docker compose *)",
      "PowerShell(docker compose *)",

      "Bash(\"/f/Unity/6000.5.5f1/Editor/Unity.exe\" -batchmode *)",
      "Bash(/f/Unity/6000.5.5f1/Editor/Unity.exe -batchmode *)",
      "PowerShell(& \"F:\\Unity\\6000.5.5f1\\Editor\\Unity.exe\" -batchmode *)",
      "PowerShell(F:\\Unity\\6000.5.5f1\\Editor\\Unity.exe -batchmode *)",

      "Bash(./infra/scripts/* *)",
      "Bash(infra/scripts/* *)",
      "PowerShell(.\\infra\\scripts\\* *)",
