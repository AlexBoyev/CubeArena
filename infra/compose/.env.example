# Copy this file to .env in the same directory and adjust as needed.
# `.env` itself is gitignored — never commit real values.

POSTGRES_USER=cubearena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cubearena
POSTGRES_PORT=5432

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Symmetric key used to sign/validate access tokens (HS256). Generate a real one with:
#   openssl rand -base64 48
AUTH_SIGNING_KEY=change-me-to-a-random-secret-at-least-32-bytes-long

# EC private key (P-256) used to sign connect tickets (ES256). The game server only ever
# sees the matching public key via GET /.well-known/jwks.json. Generate one with:
#   openssl ecparam -name prime256v1 -genkey -noout
# Paste the PEM below with real newlines replaced by literal \n (docker-compose .env
# values are single-line); the API un-escapes "\n" back into real newlines at startup.
TICKET_SIGNING_KEY_PEM=change-me-to-a-real-ec-private-key-pem-with-literal-\n-line-breaks

# Shared secret the dedicated game server sends as the X-Fleet-Api-Key header when
# registering/heartbeating. Lives only in the game server's own container environment,
# never in the Unity client build. Generate one with:
#   openssl rand -base64 32
FLEET_API_KEY=change-me-to-a-random-secret
