# Copy this file to .env in the same directory and adjust as needed.
# `.env` itself is gitignored — never commit real values.

POSTGRES_USER=cubearena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cubearena
POSTGRES_PORT=5432

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Symmetric key used to sign/validate access tokens (HS256). Generate a real one with:
#   openssl rand -base64 48
AUTH_SIGNING_KEY=change-me-to-a-random-secret-at-least-32-bytes-long
