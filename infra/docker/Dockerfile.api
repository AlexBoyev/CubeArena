FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY backend/CubeArena.sln .
COPY backend/CubeArena.Api/CubeArena.Api.csproj CubeArena.Api/
COPY backend/CubeArena.Domain/CubeArena.Domain.csproj CubeArena.Domain/
COPY backend/CubeArena.Tests/CubeArena.Tests.csproj CubeArena.Tests/
RUN dotnet restore CubeArena.sln

COPY backend/ .
RUN dotnet publish CubeArena.Api/CubeArena.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .

EXPOSE 8080
ENTRYPOINT ["dotnet", "CubeArena.Api.dll"]
