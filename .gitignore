# This .gitignore is targeted for Unity3D projects

# Unity generated folders — never commit these, they're regenerated locally
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/

# Tier 0 (docs/HOSTING.md): ready-to-run client copy dropped at the repo
# root by package-client.ps1 - never committed, same reasoning as Builds/.
/Play/
[Ll]ogs/
[Mm]emoryCaptures/
[Uu]serSettings/

# Autogenerated VS/Rider project files
.vs/
.vscode/
# Unity generates these at the repo root; backend/*.csproj and backend/*.sln
# are hand-authored .NET projects and must stay tracked.
/*.csproj
/*.unityproj
/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# .NET build output
bin/

# Local secrets — never commit a real .env, only .env.example
.env
.env.*
!.env.example
!**/.env.example

# Local SQLite dev databases
*.db
*.sqlite
*.sqlite3

# Tier 0 (docs/HOSTING.md): scratch PID/log files from
# run-gameserver-native.ps1 and local batch-mode builds — never committed.
/gameserver.pid
/gameserver_run.log
/*_build*.log
/*_build*.pid

# Unity3D generated meta files that shouldn't be ignored are NOT listed here —
# .meta files ARE tracked, they're essential to Unity project integrity

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Crashlytics generated file
crashlytics-build.properties

# Packages lock file — keep this actually, comment out if you want it ignored
# Packages/packages-lock.json

# OS-specific
.DS_Store
Thumbs.db
